rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == "REPLACE_WITH_OWNER_UID";
    }
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }
    match /affiliateClicks/{clickId} {
      allow create: if request.resource.data.keys().hasOnly(["productId","productName","source","createdAt"])
        && request.resource.data.productId is string
        && request.resource.data.productName is string
        && request.resource.data.source is string;
      allow read: if isOwner();
      allow update, delete: if false;
    }
  }
}